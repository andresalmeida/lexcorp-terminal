              </ul>
            </div>
          </div>

          <!-- Experience 3 -->
          <div class="grid md:grid-cols-[200px_1fr] gap-8 pb-12 border-b border-white/20">
            <div class="text-waystar-lime text-sm font-medium">
              Sept — Oct 2023
            </div>
            <div>
              <h3 class="text-xl font-semibold text-white mb-1">Webmaster WordPress</h3>
              <p class="text-waystar-sand font-medium mb-4">LatinCrypt Event Ecuador</p>
              <ul class="space-y-2 text-white/70">
                <li data-es="Desarrollo y mejora de accesibilidad de la web del evento LatinCrypt 2023" data-en="Development and accessibility improvement of the LatinCrypt 2023 event website">Desarrollo y mejora de accesibilidad de la web del evento LatinCrypt 2023</li>
