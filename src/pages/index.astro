            <ul class="space-y-3 text-waystar-teal">
              <li>R & Shiny</li>
              <li>Python (Pandas, NumPy)</li>
              <li>Power BI</li>
              <li>ETL Pipelines</li>
              <li data-es="Análisis Geoespacial" data-en="Geospatial Analysis">Análisis Geoespacial</li>
            </ul>
          </div>
          
          <!-- Cloud -->
          <div>
            <h3 class="text-lg font-semibold text-waystar-navy mb-6 pb-4 border-b-2 border-waystar-lime">Cloud & DevOps</h3>
