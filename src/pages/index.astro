            <ul class="space-y-3 text-waystar-teal">
              <li>Docker</li>
              <li>AWS (RDS, S3, EC2)</li>
              <li>Azure</li>
              <li>Vercel & Firebase</li>
              <li>GitHub Actions</li>
            </ul>
          </div>
          
          <!-- Gestión -->
          <div>
            <h3 class="text-lg font-semibold text-waystar-navy mb-6 pb-4 border-b-2 border-waystar-lime">Gestión & Procesos</h3>
            <ul class="space-y-3 text-waystar-teal">
              <li>BPMN & BCM</li>
              <li>AVARCIBER</li>
              <li>Documentación técnica</li>
              <li>Bizagi & Draw.io</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

