    <nav class="fixed top-0 w-full z-50 bg-waystar-navy/90 backdrop-blur-lg border-b border-white/10">
      <div class="max-w-6xl mx-auto px-6">
        <div class="flex justify-between items-center h-16">
          <a href="#" class="text-white font-medium tracking-tight">Andrés Almeida Jara</a>
          
          <div class="hidden md:flex items-center space-x-10">
            <a href="#about" class="text-white/60 hover:text-waystar-lime transition-colors text-sm" data-es="Sobre mí" data-en="About">Sobre mí</a>
            <a href="#experience" class="text-white/60 hover:text-waystar-lime transition-colors text-sm" data-es="Experiencia" data-en="Experience">Experiencia</a>
            <a href="#projects" class="text-white/60 hover:text-waystar-lime transition-colors text-sm" data-es="Proyectos" data-en="Projects">Proyectos</a>
