          <!-- Frontend -->
          <div>
            <h3 class="text-lg font-semibold text-waystar-navy mb-6 pb-4 border-b-2 border-waystar-lime">Frontend</h3>
            <ul class="space-y-3 text-waystar-teal">
              <li>React & Astro</li>
              <li>TypeScript & JavaScript</li>
              <li>Tailwind CSS</li>
              <li>ASP.NET Core</li>
            </ul>
          </div>
          
          <!-- Backend -->
          <div>
            <h3 class="text-lg font-semibold text-waystar-navy mb-6 pb-4 border-b-2 border-waystar-lime">Backend</h3>
            <ul class="space-y-3 text-waystar-teal">
              <li>Python & FastAPI</li>
              <li>Node.js & Express</li>
              <li>PostgreSQL, MySQL, SQL Server</li>
              <li>RESTful & SOAP APIs</li>
            </ul>
          </div>
          
          <!-- Data Science -->
          <div>
            <h3 class="text-lg font-semibold text-waystar-navy mb-6 pb-4 border-b-2 border-waystar-lime">Data Science</h3>
            <ul class="space-y-3 text-waystar-teal">
              <li>R & Shiny</li>
              <li>Python (Pandas, NumPy)</li>
              <li>Power BI</li>
              <li>ETL Pipelines</li>
              <li>Análisis Geoespacial</li>
            </ul>
          </div>
          
          <!-- Cloud -->
          <div>
