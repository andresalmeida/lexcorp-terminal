    <!-- Education Section -->
    <section class="py-32 bg-waystar-navy">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-20">
          <div>
            <p class="text-waystar-lime font-medium mb-4 tracking-widest text-sm uppercase" data-es="Educación" data-en="Education">Educación</p>
