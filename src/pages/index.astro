---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>Andrés Almeida Jara | Developer & Data Analyst</title>
    <meta name="title" content="Andrés Almeida Jara | Developer | Data Analyst | Geospatial Explorer | Future Scientist" />
    <meta name="description" content="Andrés Almeida Jara | Developer & Data Analyst. Desarrollo soluciones digitales basadas en datos, transformando información en decisiones efectivas." />
    <meta name="keywords" content="Full Stack Developer, Data Analyst, React, Python, R, Shiny, Portfolio, Ecuador, Quito, Desarrollador, Ciencia de Datos, Geospatial, GIS" />
    <meta name="author" content="Andrés Almeida Jara" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://adaghost.me/" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://adaghost.me/" />
    <meta property="og:title" content="Andrés Almeida Jara | Developer | Data Analyst | Geospatial Explorer | Future Scientist" />
    <meta property="og:description" content="Desarrollo soluciones digitales basadas en datos, transformando información en decisiones efectivas." />
