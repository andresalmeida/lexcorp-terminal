      <div class="max-w-6xl mx-auto px-6 py-32">
        <div class="max-w-4xl">
          <p class="text-waystar-lime font-medium mb-8 tracking-widest text-sm uppercase">Quito, Ecuador</p>
          
          <h1 class="text-6xl md:text-7xl lg:text-8xl text-white mb-8 leading-[0.9] tracking-tight" style="font-family: 'Playfair Display', serif;">
            Andrés<br/>Almeida
