                <li>Implementación de mejoras en usabilidad usando WordPress y JavaScript</li>
              </ul>
            </div>
          </div>

          <!-- Experience 4 -->
          <div class="grid md:grid-cols-[200px_1fr] gap-8">
            <div class="text-waystar-lime text-sm font-medium">
              2020 — Presente
            </div>
            <div>
