        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
          <div class="text-center">
            <div class="text-5xl md:text-6xl font-light text-waystar-navy mb-2" style="font-family: 'Playfair Display', serif;">2+</div>
            <div class="text-waystar-teal text-sm tracking-wide uppercase font-medium" data-es="Años de experiencia" data-en="Years of experience">Años de experiencia</div>
          </div>
          <div class="text-center">
            <div class="text-5xl md:text-6xl font-light text-waystar-navy mb-2" style="font-family: 'Playfair Display', serif;">10+</div>
            <div class="text-waystar-teal text-sm tracking-wide uppercase font-medium" data-es="Proyectos" data-en="Projects">Proyectos</div>
