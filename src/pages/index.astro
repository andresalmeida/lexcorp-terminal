            <div class="text-waystar-teal text-sm tracking-wide uppercase font-medium" data-es="Tecnologías" data-en="Technologies">Tecnologías</div>
          </div>
          <div class="text-center">
            <div class="text-5xl md:text-6xl font-light text-waystar-lime mb-2" style="font-family: 'Playfair Display', serif;">∞</div>
            <div class="text-waystar-teal text-sm tracking-wide uppercase font-medium" data-es="Curiosidad" data-en="Curiosity">Curiosidad</div>
          </div>
