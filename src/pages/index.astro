              <li>BPMN & BCM</li>
              <li>AVARCIBER</li>
              <li data-es="Documentación técnica" data-en="Technical documentation">Documentación técnica</li>
              <li>Bizagi & Draw.io</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Experience Section -->
    <section id="experience" class="py-32 bg-waystar-teal">
      <div class="max-w-6xl mx-auto px-6">
        <p class="text-waystar-lime font-medium mb-4 tracking-widest text-sm uppercase" data-es="Trayectoria" data-en="Career">Trayectoria</p>
        <h2 class="text-4xl md:text-5xl text-white mb-16" style="font-family: 'Playfair Display', serif;" data-es="Experiencia profesional" data-en="Professional experience">
          Experiencia profesional
        </h2>
        
        <div class="space-y-12">
