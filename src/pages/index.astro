                <li data-es="Construcción de prototipos tecnológicos para clientes iniciales" data-en="Building technology prototypes for initial clients">Construcción de prototipos tecnológicos para clientes iniciales</li>
              </ul>
            </div>
          </div>

          <!-- Experience 2 -->
          <div class="grid md:grid-cols-[200px_1fr] gap-8 pb-12 border-b border-white/20">
            <div class="text-waystar-lime text-sm font-medium">
              Jun — Sept 2024
            </div>
            <div>
              <h3 class="text-xl font-semibold text-white mb-1" data-es="Pasante Analista en Sistemas de Información" data-en="Information Systems Analyst Intern">Pasante Analista en Sistemas de Información</h3>
              <p class="text-waystar-sand font-medium mb-4" data-es="Ministerio del Ambiente, Agua y Transición Ecológica" data-en="Ministry of Environment, Water and Ecological Transition">Ministerio del Ambiente, Agua y Transición Ecológica</p>
              <ul class="space-y-2 text-white/70">
                <li data-es="Dashboards interactivos en Power BI para indicadores ambientales" data-en="Interactive Power BI dashboards for environmental indicators">Dashboards interactivos en Power BI para indicadores ambientales</li>
