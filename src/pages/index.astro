    <meta property="twitter:image" content="https://adaghost.me/og-image.jpg" />

    <meta name="theme-color" content="#02416d" />
    <link rel="icon" type="image/svg+xml" href="/lexcorp-logo.svg?v=1" />
    
    <!-- Fuentes Google Fonts - Elegantes -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Andrés Almeida Jara",
      "jobTitle": "Full Stack Developer & Data Analyst",
      "url": "https://adaghost.me",
      "email": "almeidaandres12@gmail.com",
      "sameAs": [
        "https://github.com/andresalmeida",
        "https://linkedin.com/in/andres-almeida-jara/"
      ]
    }
    </script>
  </head>
  
  <body class="bg-waystar-navy text-white antialiased">
