          </div>
          
          <div>
            <p class="text-waystar-lime font-medium mb-4 tracking-widest text-sm uppercase" data-es="Certificaciones" data-en="Certifications">Certificaciones</p>
            <h2 class="text-4xl md:text-5xl text-white mb-8" style="font-family: 'Playfair Display', serif;" data-es="Desarrollo continuo" data-en="Continuous learning">
              Desarrollo continuo
