---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AdaGhost | Software Engineer</title>
    <meta name="description" content="Ingeniero de software. Datos, geoespacial y sistemas con criterio. Quito, Ecuador." />
    <meta name="author" content="Andres Almeida Jara" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="canonical" href="https://adaghost.me/" />
    <link rel="icon" type="image/svg+xml" href="/lexcorp-logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>

  <body>
    <!-- CRT Effects -->
    <div class="crt-overlay"></div>
    <div class="scanline"></div>

    <!-- Header -->
    <header class="main-header">
      <div class="header-inner">
        <a href="#" class="logo-box">
          AdaGhost<span class="logo-cursor"></span>
        </a>
        <nav class="nav-links">
          <a href="#about">about</a>
          <a href="#experience">experience</a>
          <a href="#work">work</a>
          <a href="#contact">contact</a>
        </nav>
      </div>
    </header>

    <main>
      <!-- Hero Section -->
      <section class="hero-section">
        <div class="terminal-bg" id="terminalBg"></div>
        
        <div class="hero-grid" style="grid-template-columns: 1fr; position: relative; z-index: 2;">
          <div class="hero-content reveal" style="max-width: 800px;">
            <p class="hero-prompt">whoami</p>
            <h1 class="hero-title">
              Software engineer building <span class="highlight">systems with sense</span>
            </h1>
            <p class="hero-desc">
              Me muevo entre datos, geoespacial e IA aplicada. 
              Construyo herramientas que comunican y transforman 
              informacion en decisiones. Basado en Quito, Ecuador.
            </p>
            <div class="hero-stats">
              <div class="hero-stat">
                <span class="hero-stat-value">2+</span>
                <span class="hero-stat-label">years</span>
              </div>
              <div class="hero-stat">
                <span class="hero-stat-value">6</span>
                <span class="hero-stat-label">projects</span>
              </div>
              <div class="hero-stat">
                <span class="hero-stat-value"></span>
                <span class="hero-stat-label">curiosity</span>
              </div>
            </div>
            <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
              <a href="#work" class="btn">[ ver_proyectos ]</a>
              <a href="#contact" class="btn btn-secondary">[ contactar ]</a>
            </div>
          </div>
        </div>
      </section>

      <!-- About Section -->
      <section id="about" class="section">
        <div class="section-inner">
          <div class="section-header reveal">
            <p class="section-prompt">$ cat about.txt</p>
            <h2 class="section-title">Mas que codigo</h2>
          </div>

          <div class="about-content reveal">
            <p>
              Me interesa la tecnologia no solo por lo que puede hacer, sino por el 
              <span class="text-green">impacto social</span> que puede generar cuando se 
              aplica con proposito. Creo en construir herramientas que resuelvan 
              problemas reales de personas reales.
            </p>
            <p>
              Actualmente estoy yendo <em>deeper</em> en:
            </p>
            <ul class="interest-list">
              <li>Quantum Computing</li>
              <li>Frameworks de gestion de riesgos</li>
              <li>Inteligencia Artificial aplicada</li>
              <li>Sistemas geoespaciales</li>
            </ul>
            <p>
              Cuando no estoy codeando, probablemente estoy viendo 
              <span class="text-amber">peliculas o series</span> — es lo segundo que mas disfruto 
              despues de construir cosas.
            </p>
          </div>
        </div>
      </section>

      <!-- Skills Section -->
      <section class="section section-alt">
        <div class="section-inner">
          <div class="section-header reveal">
            <p class="section-prompt">$ cat skills.txt</p>
            <h2 class="section-title">Stack Tecnico</h2>
            <p class="section-desc">
              Herramientas que uso para construir. Me interesa la interseccion entre 
              datos, geoespacial e inteligencia artificial aplicada.
            </p>
          </div>

          <div class="skills-grid reveal">
            {skills.map((skill) => (
              <div class="skill-category">
                <h4>{skill.category}</h4>
                <div class="skill-list">
                  {skill.items.map((item) => (
                    <div class="skill-item-with-icon">
                      <img 
                        src={`https://cdn.simpleicons.org/${item.icon}/00FF41`}
                        alt={item.name}
                        class="skill-icon"
                        loading="lazy"
                        onerror="this.style.display='none'"
                      />
                      <span>{item.name}</span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Experience with Starlink Constellation -->
      <section id="experience" class="section constellation-section">
        <div class="section-inner">
          <div class="section-header reveal">
            <p class="section-prompt">$ ./deploy_constellation.sh</p>
            <h2 class="section-title">Experiencia Profesional</h2>
            <p class="section-desc">
              Cada posicion es un nodo en la red. Todos conectados, 
              todos transmitiendo conocimiento.
            </p>
          </div>

          <div class="constellation-container reveal">
            <!-- SVG Constellation Lines -->
            <svg class="constellation-lines" viewBox="0 0 1000 400" preserveAspectRatio="none">
              <defs>
                <linearGradient id="lineGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" style="stop-color:#00FF41;stop-opacity:0.1" />
                  <stop offset="50%" style="stop-color:#00FF41;stop-opacity:0.3" />
                  <stop offset="100%" style="stop-color:#00FF41;stop-opacity:0.1" />
                </linearGradient>
              </defs>
              <line class="constellation-line" x1="150" y1="200" x2="350" y2="150" />
              <line class="constellation-line" x1="350" y1="150" x2="600" y2="180" />
              <line class="constellation-line" x1="600" y1="180" x2="850" y2="120" />
              <line class="constellation-line" x1="150" y1="200" x2="600" y2="180" />
              <line class="constellation-line" x1="350" y1="150" x2="850" y2="120" />
            </svg>

            <!-- Satellite Nodes -->
            <div class="satellite-nodes">
              {experiences.map((exp, index) => (
                <div class={`satellite-node satellite-pos-${index}`} data-index={index}>
                  <div class="satellite-core"></div>
                  <div class="satellite-ring ring-1"></div>
                  <div class="satellite-ring ring-2"></div>
                  <div class="satellite-label">
                    <span class="satellite-date">{exp.date}</span>
                    <span class="satellite-role">{exp.role}</span>
                    <span class="satellite-org">@ {exp.org}</span>
                  </div>
                  <div class="satellite-pulse"></div>
                </div>
              ))}
            </div>

            <!-- Experience Cards that appear on hover -->
            <div class="constellation-cards">
              {experiences.map((exp, index) => (
                <div class="constellation-card" data-card={index}>
                  <div class="card-header">
                    <span class="card-date">{exp.date}</span>
                    <span class="card-signal">...</span>
                  </div>
                  <h3>{exp.role}</h3>
                  <p class="card-org">@ {exp.org}</p>
                  <p class="card-desc">{exp.desc}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- Projects Section -->
      <section id="work" class="section section-alt">
        <div class="section-inner">
          <div class="section-header reveal">
            <p class="section-prompt">$ ls projects/</p>
            <h2 class="section-title">Proyectos Construidos</h2>
            <p class="section-desc">
              Cosas que he desarrollado. Algunas en produccion, otras en desarrollo, 
              todas con aprendizajes valiosos.
            </p>
          </div>

          <div class="projects-grid-two reveal">
            {projects.map((proj) => (
              <article class="project-card">
                <div class="project-card-header">
                  <h3>{proj.name}</h3>
                  <span class={`project-status-badge ${proj.status === 'Archivado' ? 'archived' : proj.status === 'En validacion' ? 'wip' : proj.status === 'Publicado' ? 'live' : ''}`}>
                    {proj.status}
                  </span>
                </div>
                <p class="project-card-desc">{proj.desc}</p>
                <div class="project-card-tags">
                  {proj.tags.map((tag) => (
                    <span class="project-tag-small">{tag}</span>
                  ))}
                </div>
                {proj.externalUrl ? (
                  <a href={proj.externalUrl} target="_blank" rel="noreferrer" class="project-card-link">Ver proyecto →</a>
                ) : null}
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Contact -->
      <section id="contact" class="section">
        <div class="section-inner">
          <div class="section-header reveal" style="text-align: center;">
            <p class="section-prompt">$ ping adaghost</p>
            <h2 class="section-title">Conectemos</h2>
            <p class="section-desc" style="margin: 0 auto;">
              Si tienes un proyecto interesante, necesitas ayuda con datos, 
              o simplemente quieres conversar sobre tecnologia.
            </p>
          </div>

          <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin-top: 2rem;" class="reveal">
            <a href="mailto:almeidaandres12@gmail.com" class="btn">[ email ]</a>
            <a href="https://github.com/andresalmeida" target="_blank" class="btn btn-secondary">[ github ]</a>
            <a href="https://linkedin.com/in/andres-almeida-jara/" target="_blank" class="btn btn-secondary">[ linkedin ]</a>
            <a href="https://wa.me/593990545539" target="_blank" class="btn btn-secondary">[ whatsapp ]</a>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <span class="footer-logo">AdaGhost_</span>
          <p class="footer-desc">
            Ingeniero de software. Datos, geoespacial y sistemas con criterio. 
            Basado en Quito, Ecuador.
          </p>
        </div>
        <div class="footer-links">
          <div class="footer-col">
            <h5>navegar</h5>
            <a href="#about">about</a>
            <a href="#experience">experience</a>
            <a href="#work">work</a>
            <a href="#contact">contact</a>
          </div>
          <div class="footer-col">
            <h5>social</h5>
            <a href="https://github.com/andresalmeida" target="_blank">github</a>
            <a href="https://linkedin.com/in/andres-almeida-jara/" target="_blank">linkedin</a>
          </div>
          <div class="footer-col">
            <h5>contacto</h5>
            <a href="mailto:almeidaandres12@gmail.com">email</a>
            <a href="https://wa.me/593990545539">whatsapp</a>
          </div>
        </div>
        <div class="footer-bottom">
          <span> 2026 AdaGhost // Andres Almeida Jara</span>
          <span>echo "Built with Astro + caffeine"</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Reveal on scroll
      const reveals = document.querySelectorAll('.reveal');
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1 }
      );
      reveals.forEach((el) => observer.observe(el));

      // Smooth scroll
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', (e) => {
          e.preventDefault();
          const target = document.querySelector(anchor.getAttribute('href'));
          if (target) target.scrollIntoView({ behavior: 'smooth' });
        });
      });

      // Terminal Background Animation
      const terminalBg = document.getElementById('terminalBg');
      const terminalLines = [
        '$ npm run build',
        '> Building project...',
        '> Optimizing modules...',
        '> Success! Build completed.',
        '$ git commit -m "feat: add new feature"',
        '[main 7a8f9d2] feat: add new feature',
        ' 3 files changed, 127 insertions(+)',
        '$ docker-compose up -d',
        'Creating network "app_default"...',
        'Creating container... done',
        '$ psql -d database -c "SELECT * FROM users"',
        ' id | name | email',
        '----+------+-------',
        '  1 | ada  | ada@ghost.dev',
        '$ python manage.py migrate',
        'Operations to perform:',
        '  Apply all migrations... done',
        '$ curl -X POST api/data',
        '{"status": "success", "data": [...]}',
        '$ ./deploy.sh production',
        '> Deploying to production...',
        '> - Deployment successful',
        '$ ssh server "uptime"',
        ' 14:32:10 up 45 days, 3 users',
        '$ systemctl status app',
        '- app.service - Active (running)',
        '$ tail -f logs/app.log',
        '[INFO] Server started on port 3000',
        '[INFO] Database connected',
        '[INFO] Cache warmed up',
        '$ npm test',
        'PASS  src/tests/feature.test.js',
        'Tests: 24 passed, 24 total',
      ];

      function generateTerminalBg() {
        let html = '';
        for (let i = 0; i < 30; i++) {
          const line = terminalLines[Math.floor(Math.random() * terminalLines.length)];
          const delay = Math.random() * 3;
          const opacity = 0.3 + Math.random() * 0.5;
          html += '<span class="terminal-line-bg" style="animation-delay: ' + delay + 's; opacity: ' + opacity + ';">' + line + '</span>';
        }
        terminalBg.innerHTML = html;
      }
      generateTerminalBg();
      
      setInterval(() => {
        const lines = terminalBg.querySelectorAll('.terminal-line-bg');
        lines.forEach(line => {
          if (Math.random() > 0.95) {
            line.textContent = terminalLines[Math.floor(Math.random() * terminalLines.length)];
          }
        });
      }, 2000);

      // Constellation Interaction - Click to show card
      const satelliteNodes = document.querySelectorAll('.satellite-node');
      const constellationCards = document.querySelectorAll('.constellation-card');
      let activeCardIndex = null;
      
      satelliteNodes.forEach((node, index) => {
        node.addEventListener('click', (e) => {
          e.stopPropagation();
          
          // Toggle: if clicking same node, close it
          if (activeCardIndex === index) {
            constellationCards.forEach(card => card.classList.remove('active'));
            satelliteNodes.forEach(n => n.style.filter = '');
            activeCardIndex = null;
            return;
          }
          
          // Close all cards first
          constellationCards.forEach(card => card.classList.remove('active'));
          satelliteNodes.forEach(n => n.style.filter = '');
          
          // Open clicked card
          const card = document.querySelector('[data-card="' + index + '"]');
          if (card) {
            card.classList.add('active');
            node.style.filter = 'drop-shadow(0 0 15px #00FF41)';
            activeCardIndex = index;
          }
        });
      });
      
      // Click anywhere else to close
      document.addEventListener('click', () => {
        constellationCards.forEach(card => card.classList.remove('active'));
        satelliteNodes.forEach(n => n.style.filter = '');
        activeCardIndex = null;
      });

    </script>
  </body>
</html>
