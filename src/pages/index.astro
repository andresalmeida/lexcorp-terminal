              </ul>
            </div>
          </div>

          <!-- Experience 4 -->
          <div class="grid md:grid-cols-[200px_1fr] gap-8">
            <div class="text-waystar-lime text-sm font-medium" data-es="2023 — Presente" data-en="2023 — Present">
